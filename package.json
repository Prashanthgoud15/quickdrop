{
  "name": "quickdrop",
  "version": "1.0.0",
  "private": true,
  "description": "Temporary code-based cross-device text and file sharing",
  "scripts": {
    "dev": "concurrently -k \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
